# Normalise line endings in the repository; check out Windows scripts with CRLF (cmd.exe needs it for labels/goto)
# and shell scripts with LF, whatever core.autocrlf says on the cloning machine.
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf
*.mjs text eol=lf
*.js  text eol=lf
*.py  text eol=lf
# Text the tests read and match line by line (CSS rules, HTML, data, docs): LF everywhere, so a Windows checkout
# (core.autocrlf=true) runs `node --test` exactly like Linux and macOS.
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
# Spine atlases (the theme guide's example pack): the guide test reads the page and region lines
*.atlas text eol=lf
# binary assets
*.png binary
*.jpg binary
*.webp binary
*.skel binary
*.woff2 binary
*.otf binary
*.ttf binary
*.mp3 binary
*.ogg binary
